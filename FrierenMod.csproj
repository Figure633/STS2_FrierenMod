<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.6.19</Version>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <Import Project="GameReferences.props" />

  <ItemGroup>
    <Compile Include="Scripts/**/*.cs" />
    <Compile Include="Core/**/*.cs" />
    <!-- 隐藏 C# UID 旁文件；保留磁盘文件供 Godot 编辑器使用。 -->
    <None Remove="**/*.cs.uid" />
  </ItemGroup>

  <!-- 构建只写工作目录；部署由用户显式执行。 -->
  <Target Name="StageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildProjectDirectory)/artifacts/FrierenMod" />
    <Copy SourceFiles="$(TargetPath);FrierenMod.json;LICENSE.STS1;README.md" DestinationFolder="$(MSBuildProjectDirectory)/artifacts/FrierenMod" />
  </Target>
</Project>
