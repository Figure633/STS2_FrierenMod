<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Version>0.13.14</Version>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <Import Project="GameReferences.props" />

  <!-- 许可正文随DLL分发；工坊content只保留三个运行文件。 -->
  <ItemGroup>
    <EmbeddedResource Include="LICENSE.STS1" LogicalName="FrierenMod.Notices.LICENSE.STS1" />
    <EmbeddedResource Include="LICENSE.WATCHER" LogicalName="FrierenMod.Notices.LICENSE.WATCHER" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Scripts/**/*.cs" />
    <Compile Include="Core/**/*.cs" />
    <!-- 隐藏 C# UID 旁文件；保留磁盘文件供 Godot 编辑器使用。 -->
    <None Remove="**/*.cs.uid" />
  </ItemGroup>

  <!-- 构建只写工作目录；部署由用户显式执行。 -->
  <Target Name="StageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildProjectDirectory)/artifacts/FrierenMod" />
    <Delete Files="$(MSBuildProjectDirectory)/artifacts/FrierenMod/README.md;$(MSBuildProjectDirectory)/artifacts/FrierenMod/LICENSE.STS1;$(MSBuildProjectDirectory)/artifacts/FrierenMod/LICENSE.WATCHER" />
    <Copy SourceFiles="$(TargetPath);FrierenMod.json" DestinationFolder="$(MSBuildProjectDirectory)/artifacts/FrierenMod" />
  </Target>
</Project>
