<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <Import Project="../../GameReferences.props" />
  <ItemGroup>
    <ProjectReference Include="../../FrierenMod.csproj" />
    <Compile Include="../Integration/CombatTests.cs" Link="CombatTests.cs" />
    <Compile Include="../Integration/CombatTestState.cs" Link="CombatTestState.cs" />
    <Reference Update="sts2;0Harmony;BaseLib" Private="true" />
  </ItemGroup>
  <!-- 可选运行时的附属依赖必须进入 deps 清单；仅复制 DLL 不会让 .NET 自动解析。 -->
  <ItemGroup Condition="'$(TestRuntimeDataDir)' != ''">
    <Reference Include="$(TestRuntimeDataDir)/*.dll"
      Exclude="$(TestRuntimeDataDir)/sts2.dll;$(TestRuntimeDataDir)/GodotSharp.dll;$(TestRuntimeDataDir)/GodotSharpEditor.dll;$(TestRuntimeDataDir)/0Harmony.dll;$(TestRuntimeDataDir)/BaseLib.dll"
      Private="true" />
  </ItemGroup>
  <Target Name="CopyTestDependencies" AfterTargets="Build">
    <ItemGroup><GameDependency Include="$(Sts2DataDir)/SmartFormat*.dll;$(Sts2DataDir)/Sentry*.dll;$(Sts2DataDir)/Steamworks.NET.dll;$(Sts2DataDir)/JetBrains.Annotations.dll" /></ItemGroup>
    <Copy SourceFiles="@(GameDependency)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
